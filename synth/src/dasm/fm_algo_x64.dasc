#include <assert.h>
#include <stdint.h>

#include "../synth/fm.h"
#include "../alloc.h"
#include "../util.h"
#include "../log.h"
#include <umm_malloc/umm_malloc.h>

#define DASM_MEMPOOL_SIZE 1024

#define Dst_DECL	fm_algoc_s *Dst
#define Dst_REF		((Dst)->state)

#define DASM_M_GROW(CTX, t, p, sz, need) \
  do { \
    size_t _sz = (sz), _need = (need); \
    if (_sz < _need) { \
      if (_sz < 16) _sz = 16; \
      while (_sz < _need) _sz += _sz; \
      (p) = (t *)umm_multi_realloc(&((CTX)->dasm_heap), (p), _sz); \
      if ((p) == NULL) exit(1); \
      (sz) = _sz; \
    } \
  } while(0)

#define DASM_M_FREE(CTX, p, sz) \
    umm_multi_free(&((CTX)->dasm_heap), (p))

#include <dynasm/dasm_proto.h>
|.arch x64
|.globals lbl_
|.actionlist fm_actions

struct fm_algoc {
    dasm_State *state;
    const bpbxsyn_context_s *ctx;
    void *labels[lbl__MAX == 0 ? 1 : 0];

#ifdef _MSC_VER
    __declspec(align(8))
#else
    __attribute__((aligned(8)))
#endif
    uint8_t dasm_mempool[DASM_MEMPOOL_SIZE];
    umm_heap dasm_heap;
};

#include <dynasm/dasm_x86.h>

fm_algoc_s *bbsyn_fm_algoc_new(const bpbxsyn_context_s *ctx) {
    fm_algoc_s *self = bpbxsyn_malloc(ctx, sizeof(fm_algoc_s));
    *self = (fm_algoc_s) { .ctx = ctx };
    umm_multi_init_heap(&self->dasm_heap, self->dasm_mempool,
                        DASM_MEMPOOL_SIZE);
    return self;
}

void bbsyn_fm_algoc_destroy(fm_algoc_s *algoc) {
    if (!algoc) return;
}

fm_algo_f bbsyn_fm_algoc_compile(fm_algoc_s *algoc, const fm_desc_s *desc,
                                 const float *sine_wave, void *code_rw,
                                 const void *code_x, size_t max_size)
{
    bbsyn_logmsgf(algoc->ctx, BPBXSYN_LOG_DEBUG, "compile FM algorithm!");

    dasm_init(algoc, 1);
    dasm_setupglobal(algoc, algoc->labels, lbl__MAX);
    dasm_setup(algoc, fm_actions);

    int opcount = desc->operator_count;

    #define Dst algoc
    | .type opst, fm_voice_opstate_s
    |
    | .macro sample_sine_wave
    |     // [in]  xmm1: register where phase is stored
    |     // [out] xmm0
    |     // destroys rax, rdx, and xmm0-3
    |     // r8 is where the sine wave ptr is stored
    |     cvttsd2si eax, xmm1
    |     movzx edx, al
    |     cvtsi2sd xmm3, eax
    |     subsd xmm1, xmm3
    |     cvtss2sd xmm2, dword [r8 + rdx * 4]
    |     cvtss2sd xmm0, dword [r8 + rdx * 4 + 4]
    |     subsd xmm0, xmm2
    |     mulsd xmm0, xmm1
    |     addsd xmm0, xmm2
    | .endmacro

    // function parameters:
    // rcx: fm_opstate_s *opstates
    // xmm1: double feedback amp

    // initiate prologue
    const int frame_size = ALIGN(opcount * 8, 16);
    | sub rsp, frame_size;
    for (int i = 0; i < opcount; ++i) {
        | movsd qword [rsp + (i*8)], xmm(8+i)
        | pxor xmm(8+i), xmm(8+i)
    }
    | pxor xmm2, xmm2
    | pxor xmm0, xmm0
    | pxor xmm3, xmm3

    | // r8: float *sine_wave
    | // r9: fm_opstate_s *opstates;
    | // xmm5: double feedback_amp
    | mov64 r8, ((uintptr_t)sine_wave)
    | mov r9, rcx
    | movsd xmm5, xmm1
    
    // destroys rax, rdx, and xmm0-3
    for (int i = opcount - 1; i >= 0; --i) {
        int modf = desc->mod[i];
        int fdbf = desc->fdb[i];
        | movsd xmm1, qword opst:r9[i].phase

        // add modulation and feedback
        for (int j = 0; j < opcount; ++j) {
            if (modf & (1 << j))
                | addsd xmm1, xmm(8+j)

            if (fdbf & (1 << j)) {
                | movsd xmm2, qword opst:r9[j].output
                | mulsd xmm2, xmm5
                | addsd xmm1, xmm2
            }
        }

        | sample_sine_wave
        | movsd qword opst:r9[i].output, xmm0
        | mulsd xmm0, qword opst:r9[i].expression
        | movsd xmm(8+i), xmm0
    }

    // return the sum of all the carrier outputs
    | pxor xmm0, xmm0
    for (int i = 0; i < desc->carrier_count; ++i) {
        | addsd xmm0, xmm(8+i)
    }

    // initiate epilogue
    for (int i = 0; i < opcount; ++i) {
        | movsd xmm(8+i), qword [rsp + (i * 8)]
    }
    | add rsp, frame_size
    | ret
    #undef Dst

    size_t szp;
    if (!dasm_link(algoc, &szp))
        goto error;

    assert(szp <= max_size);

    if (szp > max_size) goto error;

    if (!dasm_encode(algoc, code_rw))
        goto error;

    // double const (*func)(double a, double b) = code_x;
    // double val = func(1.0, 2.0);
    // assert(val == 3.0);

    dasm_free(algoc);
    return (fm_algo_f) code_x;

    error:
        dasm_free(algoc);
        return NULL;
}